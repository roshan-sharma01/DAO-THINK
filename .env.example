# Copy to .env (or run: python scripts/new_local_env.py) and keep .env private.
# Never commit .env or private_keys.json. Each agent needs its own distinct seed.

# 1 = local development (seed-derived addresses, localhost endpoints, no mailbox).
# 0 = hosted mode (Agentverse mailbox or public endpoint).
DAOTHINK_LOCAL=1
AGENT_NAME=daoaction-orchestrator

ORCHESTRATOR_SEED=
RESEARCH_AGENT_SEED=
ANALYSIS_AGENT_SEED=
TEST_CLIENT_SEED=

# Proposal used by tests/send_local_request.py and scripts/run_local_e2e.sh.
# Quote it: Snapshot URLs contain '#', which starts a comment in .env files.
DAO_PROPOSAL_URL="https://snapshot.org/#/<space>/proposal/<proposal-id>"
# Optional. Leave blank unless you know the real values; they are never guessed.
DAO_PROPOSAL_ID=
DAO_PROPOSAL_TITLE=
DAO_REQUESTED_AMOUNT=
DAO_TREASURY_BALANCE=

# ---- Hosted mode only (DAOTHINK_LOCAL=0) ----
MAILBOX_ENABLED=true
# Leave blank when using an Agentverse mailbox.
AGENT_ENDPOINT=
ANALYSIS_AGENT_ENDPOINT=
# Registered addresses of the peers. If blank, they are derived from the seeds above.
RESEARCH_AGENT_ADDRESS=
ANALYSIS_AGENT_ADDRESS=
AGENT_PORT=8000
ANALYSIS_AGENT_PORT=8002

# Optional hosted mailbox integration test (a separate, dedicated identity).
ANALYSIS_INTEGRATION_TEST_SEED=
